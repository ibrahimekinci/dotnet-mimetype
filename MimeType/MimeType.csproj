<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>dotnet-MimeType</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ibrahim Ekinci</Authors>
    <Company>Ibrahim Ekinci</Company>
    <Product>MimeType Utility Library</Product>
    <Description>A .NET library for detecting MIME types and file extensions based on file signatures and mappings.</Description>
    <RepositoryUrl>https://github.com/ibrahimekinci/dotnet-mimetype</RepositoryUrl>
    <PackageTags>mime mimetype filetype detection extension signature</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/ibrahimekinci/dotnet-mimetype</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
