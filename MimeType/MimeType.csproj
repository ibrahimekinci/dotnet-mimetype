<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>MimeType</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ibrahim Ekinci</Authors>
    <Company>Ibrahim Ekinci</Company>
    <Product>MimeType Utility Library</Product>
    <Description>Reliable MIME type and file extension detection based on magic numbers and signatures.</Description>
    <RepositoryUrl>https://github.com/ibrahimekinci/dotnet-mimetype</RepositoryUrl>
    <PackageTags>mime mimetype filetype detection extension signature</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
